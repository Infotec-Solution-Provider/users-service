# Copy to local/.env (ignored by git).
# IP of this machine on the ZeroTier network where the PBX is (inpulse network: 172.22.x.x).
GW_ZT_IP=
# Same value as TELEPHONY_GATEWAY_API_KEY in users-service/.env (hex, 64 characters).
GW_API_KEY=
# Origin of the local frontend.
GW_ORIGIN=http://localhost:3000
