LISTEN_PORT=8001
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_REFRESH_ENABLED=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_IDLE_DAYS=30
REFRESH_TOKEN_PEPPER=<generate_a_long_random_secret>
AUTH_ALLOWED_ORIGINS="http://localhost:3000,https://inpulse.infotecrs.inf.br"
AUTH_COOKIE_SECURE=false
JWT_SECRET_KEY=<your_secret_key>
INSTANCES_API_URL="http://localhost:8000"
WEB_PUSH_VAPID_SUBJECT="mailto:suporte@exemplo.com"
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
PUSH_NOTIFICATIONS_SECRET=

# Gateway WebRTC -> SIP para centrais sem WebRTC (deploy/telephony-gateway). Sem todas as variaveis,
# o modo "Via gateway in.pulse" fica indisponivel na tela SIP.
# Endereco publico WSS do gateway (nginx -> Kamailio). Sem query string.
TELEPHONY_GATEWAY_WSS_URL=
# Segredo HMAC dos tokens entregues ao navegador (minimo 32 caracteres). Fica so no users-service.
TELEPHONY_GATEWAY_TOKEN_SECRET=
# Chave que o Kamailio envia em X-Telephony-Gateway-Key (minimo 32 caracteres). Mesmo valor do kamailio.cfg.
TELEPHONY_GATEWAY_API_KEY=
# Redes IPv4 onde as centrais podem estar, separadas por virgula (prefixo minimo /8). Ex.: rede ZeroTier.
TELEPHONY_GATEWAY_ALLOWED_NETWORKS=172.22.0.0/16
# Validade do token em segundos (300 a 86400; padrao 43200 = 12 h).
TELEPHONY_GATEWAY_TOKEN_TTL_SECONDS=43200
